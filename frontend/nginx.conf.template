# En el despliegue recomendado a producción (ver README, "Configurar Nginx
# como reverse proxy del host"), hay DOS saltos de proxy: cliente -> nginx
# del host (ahí termina el HTTPS) -> este nginx (dentro de Docker) ->
# backend. Si aquí simplemente se reenviara X-Forwarded-Proto como
# "$scheme", el backend siempre vería "http" (el esquema de la conexión
# nginx-del-host -> este contenedor, que nunca es https), sin importar que
# el cliente sí haya usado HTTPS de verdad — rompería, por ejemplo, la
# detección automática de URL del correo de invitación (ver
# enviarInvitacionPortal en server.js), que quedaría con "http://" aunque
# el sitio real sea "https://".
# Este mapeo usa el valor de X-Forwarded-Proto que ya haya puesto un proxy
# anterior (el nginx del host), y solo cae de vuelta a "$scheme" cuando no
# hay ninguno (ej. en desarrollo local, sin ese nginx adicional en frente).
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Auditoria de seguridad (frontend, OWASP Top 10 2021): Strict-Transport-
# Security solo tiene sentido si la conexion de verdad llego por HTTPS —
# mandarlo siempre, incluso en HTTP simple (como el "http://localhost"
# de este entorno de desarrollo sin el nginx del host en frente), le
# diria al navegador que fuerce HTTPS en este host aunque el sitio no lo
# sirva, rompiendo el acceso. Se reusa el mismo criterio que
# $proxy_x_forwarded_proto de arriba (X-Forwarded-Proto del proxy del
# host si existe, si no el esquema real de la conexion a este nginx): el
# header solo se agrega cuando ese valor es "https". Con add_header, un
# valor de variable vacio hace que nginx NO mande el header en absoluto
# (desde nginx 1.7.5) — no hace falta "if" para lograr la condicion.
map $proxy_x_forwarded_proto $hsts_header_valor {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# Grupo de conexiones reutilizables hacia el backend. Sin esto, nginx abre
# una conexión TCP nueva con el backend en CADA petición a /api/ — bajo
# tráfico normal no se nota, pero bajo carga (o con muchas peticiones
# seguidas, como al cargar una tabla grande) agrega overhead innecesario y
# puede contribuir a lentitud/errores intermitentes por agotar sockets más
# rápido de lo necesario. "keepalive 16" mantiene hasta 16 conexiones
# ociosas listas para reusar. Esto es una optimización de UNA sola
# instancia — no es balanceo de carga (eso implicaría varios servers aquí
# abajo, y queda fuera de este cambio a propósito).
upstream backend_upstream {
    server backend:4000;
    keepalive 16;
}

# App de control, en su propio contenedor desde el segmento 9b (ver
# PROJECT_STATE.md) — a propósito NO es un nombre de servicio Docker fijo:
# CONTROL_UPSTREAM_HOST/CONTROL_UPSTREAM_PORT son variables de entorno del
# contenedor "frontend", sustituidas aquí por envsubst al arrancar (este
# archivo vive en /etc/nginx/templates/, la imagen oficial de nginx lo
# procesa sola — ver frontend/Dockerfile). Por defecto apuntan al servicio
# "control" en la misma red Docker, pero pueden apuntar a cualquier
# host/IP/dominio si ese contenedor se despliega en un servidor aparte.
# Nota: envsubst SOLO sustituye nombres que son de verdad variables de
# entorno del contenedor -- las variables propias de nginx como $host o
# $request_uri no se tocan, así que es seguro usarlo en todo este archivo.
upstream control_upstream {
    server ${CONTROL_UPSTREAM_HOST}:${CONTROL_UPSTREAM_PORT};
    keepalive 8;
}

server {
    listen 80;
    # "localhost" explícito (en vez del comodín "_" genérico) porque el
    # despliegue objetivo de este nginx es local — sigue funcionando
    # igual si en el futuro se pone detrás de un dominio real, ya que
    # nginx solo usa server_name para elegir ENTRE varios "server {}"
    # cuando hay más de uno; con solo este bloque, cualquier Host que
    # llegue lo recibe de todas formas.
    server_name localhost;

    # Auditoria de seguridad (frontend, OWASP A05:2021 Security
    # Misconfiguration): no anunciar la version exacta de nginx en la
    # cabecera "Server" ni en las paginas de error generadas por nginx —
    # reduce la informacion disponible para un atacante que busque
    # vulnerabilidades conocidas de una version especifica.
    server_tokens off;

    root /usr/share/nginx/html;
    index login.html;

    client_max_body_size 20m;

    # Segmento 7 (seguridad multi-tenant): cabeceras de defensa aplicables
    # a TODA respuesta sin riesgo de romper nada existente.
    # X-Frame-Options SAMEORIGIN (no DENY, 2026-09-17): con DENY, Chrome
    # bloquea su propio visor de PDF integrado cuando una página intenta
    # mostrar un PDF (incluso un blob: creado por la misma página, como
    # el preview de constancias) dentro de un <iframe> — el visor cuenta
    # como "framed content" y DENY se lo prohíbe a la página framearse a
    # sí misma. Reportado por el usuario en producción (Linux): el modal
    # de vista previa de la CSF quedaba en blanco con "Este contenido
    # está bloqueado. Para solucionar el problema, ponte en contacto con
    # el propietario del sitio web." — mensaje propio de Chrome, no un
    # error de la app. SAMEORIGIN sigue bloqueando clickjacking desde
    # OTROS orígenes (la amenaza real) y permite que la página se
    # enmarque a sí misma, que es justo lo que el preview necesita.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(self), microphone=()" always;
    # Auditoria de seguridad (frontend): HSTS condicional — ver el map
    # $hsts_header_valor de arriba para el motivo de por que no es
    # incondicional. Sin efecto en este entorno mientras no haya HTTPS
    # real en frente; queda listo para cuando lo haya (mismo criterio ya
    # usado para X-Forwarded-Proto en este archivo).
    add_header Strict-Transport-Security $hsts_header_valor always;
    # Content-Security-Policy (auditoría 2026-09-03, hallazgo #11) — antes
    # quedaba fuera a propósito por no poder inventariar cada script/
    # estilo inline de las páginas. Inventario real hecho para esta
    # revisión: CERO <script> inline y CERO onclick/onerror inline en las
    # 8 páginas de /admin, /control y el portal de cliente (el único
    # onerror que había, en la imagen decorativa del login, se movió a
    # theme.js) — así que script-src no necesita 'unsafe-inline' ni
    # 'unsafe-eval'. style-src SÍ lo lleva: hay ~11 atributos style="..."
    # estáticos (sin datos de usuario, verificado) y sería mucho trabajo
    # para poco beneficio real convertirlos a clases — mismo criterio ya
    # aceptado en la CSP de Swagger (server.js) para su propio bundle.
    # https://fonts.googleapis.com/https://fonts.gstatic.com: style.css
    # (cargado en TODAS las páginas) importa la tipografía Inter desde
    # Google Fonts — sin esto, el sitio completo perdería su tipografía.
    # mantenimiento.html tiene su PROPIA política más permisiva (ver su
    # location dedicado abajo, antes del catch-all) porque es la única
    # página con un <script> inline real (el polling de /api/health).
    # frame-ancestors 'self' (no 'none', ver X-Frame-Options arriba):
    # mismo motivo — permite que la página se enmarque a sí misma para
    # que el preview de PDF (constancias) funcione, sin abrir la puerta a
    # que OTRO origen la enmarque.
    # frame-src 'self' blob: (bug real 2026-09-17, ver PROJECT_STATE.md):
    # sin 'blob:' explícito, Chrome bloquea la navegación del <iframe> a
    # un blob: (preview de PDF vía fetch autenticado + createObjectURL,
    # el mismo patrón de imágenes de storage.js) con "Este contenido está
    # bloqueado" — default-src 'self' NO cubre el scheme blob: para
    # frame-src, a diferencia de img-src que ya lo tenía explícito.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; frame-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';" always;

    # JS y CSS propios de la app cambian con cada despliegue: se permite
    # cachear, pero SIEMPRE se revalida con el servidor antes de usar la
    # copia local (peticion condicional ligera - 304 si no cambio, 200 con
    # el archivo nuevo si si cambio). Esto evita que el navegador siga
    # usando una version vieja por dias despues de un `docker-compose up --build`.
    location ~* \.(?:css|js)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Assets realmente estaticos (fuentes, imagenes) que no cambian entre
    # despliegues si pueden cachearse agresivamente.
    location ~* \.(?:svg|png|jpg|jpeg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # Location dedicado para mantenimiento.html (auditoría 2026-09-03,
    # hallazgo #11): es la única página con un <script> inline real (el
    # polling de /api/health) — necesita su PROPIA CSP más permisiva en
    # script-src, en vez de relajar la del resto del sitio por una sola
    # página que ni siquiera se visita directo casi nunca (solo cuando el
    # backend/control no responde). Antes de este location no hacía falta
    # ninguno propio porque el catch-all de abajo ya la servía igual de
    # bien — pero declarar add_header aquí exige repetir TODOS los que
    # aplican (nginx no hereda ninguno del server si el location define
    # al menos uno propio).
    location = /mantenimiento.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(self), microphone=()" always;
        add_header Strict-Transport-Security $hsts_header_valor always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
        try_files /mantenimiento.html =404;
    }

    location / {
        try_files $uri $uri/ /login.html;
    }

    # Panel de administracion, accesible en /admin (sin necesidad de .html)
    location = /admin {
        try_files /admin.html =404;
    }

    # App de control (segmento 9, contenedor propio desde el segmento 9b):
    # gestion cross-tenant del ciclo de vida de empresas, solo perfil
    # "super". Esta pagina estatica sigue sirviendola este mismo frontend
    # -- solo su API (/api/control/*) se reenvia al contenedor aparte, ver
    # el location "^~ /api/control/" mas abajo.
    location = /control {
        try_files /control.html =404;
    }

    # Rutas amigables (sin .html) para las paginas del portal de usuario
    location = /dashboard {
        try_files /dashboard.html =404;
    }
    location = /tickets {
        try_files /tickets.html =404;
    }
    location = /login {
        try_files /login.html =404;
    }
    location = /csf {
        try_files /csf.html =404;
    }
    location = /mi-cuenta {
        try_files /mi-cuenta.html =404;
    }
    # Sin access_log (auditoría 2026-09-03, hallazgo #10): el enlace de
    # restablecimiento lleva el token como query string
    # (?token=...) — el formato de log combinado de nginx incluye la
    # query completa en $request, así que sin esto el token de un solo
    # uso quedaría en texto plano en access.log durante su ventana de
    # validez (30 min). El token igual se invalida al usarse
    # (server.js), esto es defensa en profundidad, no el único control.
    location = /restablecer {
        access_log off;
        try_files /restablecer.html =404;
    }

    # Compatibilidad: esta pagina (constancia de situacion fiscal) se
    # llamaba "index.html" antes de renombrarse a "csf.html". Si alguien
    # tiene un enlace o marcador viejo apuntando a /index.html, se
    # redirige en vez de devolver 404.
    location = /index.html {
        return 301 /csf.html;
    }

    # ---------- Multi-tenant (segmento 4 del plan, ver PROJECT_STATE.md) ----------
    # Rutas con forma "/<slug>/admin", "/<slug>/dashboard", etc. — mismo
    # archivo HTML de siempre, servido para CUALQUIER slug con forma
    # razonable (nginx no valida contra la lista real de tenants dados de
    # alta; eso lo hace el backend mismo — ver
    # backend/utils/tenantContext.js — al resolver el encabezado
    # X-Tenant-Slug). Esto es a propósito: dar de alta un tenant nuevo NO
    # requiere tocar ni recargar este archivo, solo un alta en la base de
    # datos de control. El regex de aquí es deliberadamente más permisivo
    # que backend/utils/tenant.js:validarSlug() (que sí es la validación
    # autoritativa) — nginx solo necesita capturar un candidato razonable
    # y dejar que el backend decida si es válido/existe.
    #
    # Estas dos ubicaciones son las ÚNICAS que dependen del patrón
    # "/<slug>/<pagina>" para servir HTML — las rutas SIN prefijo de
    # arriba (/admin, /dashboard, etc.) siguen intactas, sirviendo el
    # tenant único de siempre mientras el segmento 6 (cutover) no se haya
    # ejecutado.
    # El regex va entre comillas a proposito: el cuantificador "{0,48}"
    # sin comillas hace que el tokenizador de configuracion de nginx lo
    # confunda con el inicio de un bloque ("{" es un token especial fuera
    # de comillas, con o sin espacio antes), truncando el patron real
    # antes de llegar a pcre2_compile() y produciendo el error "missing
    # closing parenthesis" — confirmado corriendo esto contra un nginx
    # real (ver PROJECT_STATE.md).
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/admin$" {
        try_files /admin.html =404;
    }
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/(?<pagina_tenant>dashboard|tickets|login|csf|mi-cuenta)$" {
        try_files /$pagina_tenant.html =404;
    }
    # Separado del location de arriba (mismo motivo que "location =
    # /restablecer" sin slug): access_log off para no persistir el token
    # de restablecimiento en texto plano.
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/restablecer$" {
        access_log off;
        try_files /restablecer.html =404;
    }

    # Bug real encontrado en auditoría (2026-09-01): visitar SOLO "/<slug>"
    # (sin página después, ej. favorito guardado a la raíz del tenant) no
    # matcheaba NINGUNO de los dos locations de arriba ni el "location =
    # /login" de arriba (ese es exacto, sin slug) — caía al catch-all
    # "location /" de más abajo, que sirve login.html vía try_files SIN
    # cambiar la URL. La barra de direcciones seguía mostrando "/<slug>"
    # (parecía estar en el contexto del tenant) pero el HTML servido era
    # el mismo login.html de siempre, y como esta ruta NO tiene forma
    # "/<slug>/algo", frontend/login.js (con la MISMA lista
    # RUTAS_PAGINA_MULTITENANT y el mismo `segmentos.length >= 2` que
    # portal.js) no detectaba ningún tenant — el login que parecía ser del
    # tenant en realidad autenticaba contra la base SIN tenant
    # (`portal_facturacion`), y si el RFC no existía ahí fallaba con "RFC
    # o contraseña incorrectos" pese a ser válido en el tenant real; si el
    # MISMO RFC sí existía en ambos (el caso que reportó el usuario:
    # "puedo tener el mismo RFC en diferentes empresas"), el login
    # succedía contra la empresa equivocada y el JS redirigía a
    # "/dashboard" sin slug — el sitio "sin tenant" que describió. Fix:
    # redirigir "/<slug>" (con o sin "/" final) a "/<slug>/login" — mismo
    # criterio que ya usa "/" a secas (index login.html) pero explícito en
    # la URL, para que login.js SIEMPRE detecte el tenant correctamente.
    # $http_host (no $host) + $proxy_x_forwarded_proto (definidos arriba,
    # mismo criterio que detectarUrlPortal en el backend): un "return 302
    # /ruta" con path absoluto deja que nginx arme el Location con
    # $scheme://$host, pero $host NUNCA incluye el puerto — en este
    # entorno de desarrollo (mapeo de Docker a :8088) el navegador
    # terminaba redirigido a :80 (nada escuchando ahí), confirmado con
    # curl -D- durante la validación. $http_host es el encabezado Host tal
    # cual lo mandó el cliente (incluye el puerto si no es el estándar) —
    # nunca falla el reenvío sin importar el puerto externo.
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/?$" {
        return 302 $proxy_x_forwarded_proto://$http_host/$tenant_slug/login;
    }

    # Version con tenant de la API — mismo backend, mismo proxy_pass que
    # "location /api/" de abajo, con el slug capturado reenviado como
    # encabezado X-Tenant-Slug (el backend nunca ve el prefijo en la URL,
    # ver backend/utils/tenantContext.js). Se mantiene deliberadamente
    # como un bloque casi idéntico a "location /api/" (no una sola
    # definicion reutilizada) porque nginx no tiene una forma limpia de
    # "heredar" un location completo — si se ajusta algo aquí (timeouts,
    # limite de tamaño, pagina de mantenimiento), replicar el cambio en
    # "location /api/" también.
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/api/(?<resto_api>.*)$" {
        # Auditoría 2026-09-03 (hallazgo #11): esta ruta se reenvía al
        # backend, que ya manda su propia Content-Security-Policy (helmet
        # + la calibrada a mano para /api/docs) — sin repetir aquí los
        # otros 5 headers, la respuesta se quedaría sin ellos (declarar
        # add_header en un location apaga la herencia del server para
        # TODOS, no solo para el que se agrega).
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(self), microphone=()" always;
        add_header Strict-Transport-Security $hsts_header_valor always;
        proxy_pass http://backend_upstream/api/$resto_api$is_args$args;
        proxy_set_header X-Tenant-Slug $tenant_slug;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host (no $host) — mismo gotcha ya documentado arriba para el
        # redirect de "/<slug>": $host NUNCA incluye el puerto, así que en
        # localhost:8088 (o cualquier puerto no estándar) el backend veía
        # "Host: localhost" sin puerto vía req.get('host'), y
        # detectarUrlPortal() (backend/server.js) armaba el link de los
        # correos (confirmación de venta, invitación, etc.) apuntando a
        # :80 en vez de al puerto real. $http_host es el encabezado Host
        # tal cual lo mandó el cliente, con puerto incluido si no es el
        # estándar.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        client_max_body_size 20m;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /mantenimiento.html;
    }

    # Extensión del fix del punto 178 (ver PROJECT_STATE.md punto 185):
    # aquel fix solo cubrió "/<slug>" solo (sin nada después), pero
    # "/<slug>/<algo-no-reconocido>" (ej. "/<slug>/control" -- control es
    # cross-tenant, nunca existe por tenant -- o cualquier página vieja/
    # typo) tenía el MISMO problema: no matcheaba ninguno de los
    # locations de arriba (admin/página de tenant/slug solo/api de
    # tenant, todos ya evaluados antes que este por estar definidos
    # primero) y caía al catch-all "location /" de más abajo, que sirve
    # login.html vía try_files SIN cambiar la URL ni devolver 404. La
    # barra de direcciones seguía mostrando "/<slug>/algo" pero
    # frontend/login.js (RUTAS_PAGINA_MULTITENANT, "control" no está en
    # esa lista) no detectaba tenant, autenticando contra la base SIN
    # tenant -- confirmado con curl (200, sirve login.html) antes de este
    # fix. Este location va DESPUÉS de todos los anteriores a propósito
    # (nginx evalúa locations con regex en el orden en que aparecen en el
    # archivo, el primero que matchea gana) para no interceptar ninguna
    # ruta válida ya cubierta arriba -- solo lo que ninguna otra regla
    # reconoció.
    location ~ "^/(?<tenant_slug>[a-z0-9][a-z0-9-]{0,48})/.+$" {
        return 404;
    }

    # Segmento 9b: API de la app de control, reenviada a su propio
    # contenedor (control_upstream, ver arriba) en vez de a
    # backend_upstream. "^~" y el prefijo "/api/control/" (más largo y
    # específico que "/api/" de abajo) hacen que nginx elija SIEMPRE este
    # bloque para estas rutas, sin importar el orden de declaración entre
    # los dos "^~" — nginx prioriza el prefijo más largo que matchea.
    # X-Tenant-Slug se blanquea explícitamente por el mismo motivo que en
    # "/api/": /control es cross-tenant por definición, nunca debe
    # resolver un tenant a partir de un header que mande el cliente.
    location ^~ /api/control/ {
        # Auditoría 2026-09-03 (hallazgo #11): mismo motivo que en la ruta
        # de API con tenant — control ya manda su propia CSP.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(self), microphone=()" always;
        add_header Strict-Transport-Security $hsts_header_valor always;
        proxy_pass http://control_upstream/api/control/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Tenant-Slug "";
        # $http_host (no $host) — mismo gotcha ya documentado arriba para el
        # redirect de "/<slug>": $host NUNCA incluye el puerto, así que en
        # localhost:8088 (o cualquier puerto no estándar) el backend veía
        # "Host: localhost" sin puerto vía req.get('host'), y
        # detectarUrlPortal() (backend/server.js) armaba el link de los
        # correos (confirmación de venta, invitación, etc.) apuntando a
        # :80 en vez de al puerto real. $http_host es el encabezado Host
        # tal cual lo mandó el cliente, con puerto incluido si no es el
        # estándar.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 1m;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /mantenimiento.html;
    }

    # Reenvia las peticiones de la API SIN tenant (comportamiento de
    # siempre) al backend. "^~" evita que nginx llegue a evaluar los
    # locations con expresion regular de arriba para cualquier ruta que
    # empiece literalmente con "/api/" — sin esto, el orden de
    # definicion decide, y una ruta regex mal escrita en el futuro podria
    # interceptar trafico de la API que no lleva tenant. No cambia el
    # comportamiento de hoy (antes de este segmento no existia ningun
    # location con regex con el que pudiera competir).
    location ^~ /api/ {
        # Auditoría 2026-09-03 (hallazgo #11): mismo motivo que las otras 2
        # rutas de API — el backend ya manda su propia CSP.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(self), microphone=()" always;
        add_header Strict-Transport-Security $hsts_header_valor always;
        proxy_pass http://backend_upstream/api/;
        proxy_http_version 1.1;
        # Necesario para que el "keepalive" del upstream de arriba
        # realmente se use — por default, nginx reenvía el header
        # "Connection: close" del cliente al backend en cada petición,
        # lo que impediría reusar la conexión aunque esté definida como
        # keepalive.
        proxy_set_header Connection "";
        # Segmento 7 (seguridad multi-tenant): esta es la ruta SIN slug en
        # la URL, así que el backend NUNCA debe resolver ningún tenant a
        # partir de ella. nginx reenvía por default cualquier header que
        # el cliente mande — sin este blanqueo explícito, un cliente podía
        # mandar su propio "X-Tenant-Slug: <slug-ajeno>" directo a
        # /api/... y cruzar al pool/BD de ese tenant, evitando por
        # completo los locations con regex de arriba (los únicos que
        # deben poder fijar este header, y lo hacen desde el slug que
        # ELLOS capturaron de la URL, no desde lo que mande el cliente).
        proxy_set_header X-Tenant-Slug "";
        # $http_host (no $host) — mismo gotcha ya documentado arriba para el
        # redirect de "/<slug>": $host NUNCA incluye el puerto, así que en
        # localhost:8088 (o cualquier puerto no estándar) el backend veía
        # "Host: localhost" sin puerto vía req.get('host'), y
        # detectarUrlPortal() (backend/server.js) armaba el link de los
        # correos (confirmación de venta, invitación, etc.) apuntando a
        # :80 en vez de al puerto real. $http_host es el encabezado Host
        # tal cual lo mandó el cliente, con puerto incluido si no es el
        # estándar.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        client_max_body_size 20m;

        # Página de mantenimiento cuando el backend no responde. 502/504
        # los genera el propio nginx cuando no logra conectar o el
        # backend se tarda demasiado (ej. el contenedor se está
        # reiniciando); "proxy_intercept_errors on" además intercepta un
        # 503 explícito que el backend mismo llegara a devolver, en vez
        # de dejarlo pasar tal cual. El navegador sigue recibiendo el
        # código de estado real (503) junto con la página — así una
        # petición hecha con fetch() todavía puede detectar "esto no
        # salió bien" por el status, aunque el cuerpo ya no sea el JSON
        # que esperaba. No hace falta un "location" aparte para
        # mantenimiento.html: es un archivo estático real, así que el
        # "location /" de más abajo (con su try_files) ya lo sirve solo,
        # tanto en esta redirección interna como si alguien lo visita
        # directamente.
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /mantenimiento.html;
    }
}
