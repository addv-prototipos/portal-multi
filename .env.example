# Puerto donde se expone el frontend en el host — 80 por defecto, para
# poder entrar directamente a http://localhost sin agregar ningún puerto
# a la URL. Si vas a poner un Nginx del host delante (dominio real +
# HTTPS, ver "Despliegue a producción" en el README), cambia esto a 8080
# — ese Nginx del host necesita el puerto 80 para sí mismo.
FRONTEND_PORT=80

# --- Base de datos (MySQL) ---
# IMPORTANTE: cambia estas contraseñas antes de desplegar en producción.
# La contraseña de root de MySQL (administración del servidor de base de datos)
MYSQL_ROOT_PASSWORD=changeme_root_password
# Nombre de la base de datos que usa la aplicación
MYSQL_DATABASE=portal_facturacion
# Usuario de la aplicación (no root) que usa el backend para conectarse
MYSQL_USER=app
MYSQL_PASSWORD=changeme_app_password
# Puerto de MySQL expuesto en el host (util para conectarte con un cliente
# como MySQL Workbench/TablePlus/DBeaver a inspeccionar los datos). Puedes
# quitar el mapeo de puertos en docker-compose.yml si no lo necesitas.
MYSQL_PORT=3306

# --- MySQL en alta disponibilidad (segmento 8 del plan multi-tenant,
#     solo aplica a docker-stack.yml / despliegue con Docker Swarm, ver
#     PROJECT_STATE.md y el encabezado de docker-stack.yml) ---
# Contraseña del usuario de replicación (privilegio único: REPLICATION
# SLAVE, sin acceso a datos de aplicación). La usa
# backend/scripts/configure-replica.js para enganchar la réplica al
# primario -- IMPORTANTE: cambia este valor antes de producción, igual
# que las demás contraseñas de este archivo.
# MYSQL_REPLICATION_USER=repl
# MYSQL_REPLICATION_PASSWORD=changeme_replication_password

# --- App de control (segmento 9b del plan multi-tenant, ver
#     PROJECT_STATE.md) — /control vive en su propio contenedor
#     ("control"), separado del backend por seguridad y para poder
#     desplegarse en otro servidor. ---
# IMPORTANTE: cambia esta contraseña antes de producción. Es la credencial
# MySQL angosta del contenedor "control" (solo control_tenants, sin
# acceso a ninguna base tenant_*) — se crea/rota corriendo (una vez)
# backend/scripts/provisionar-tenant.js o cutover-tenant-piloto.js con
# esta misma variable definida en el entorno (requiere MYSQL_ROOT_PASSWORD,
# igual que cualquier otro alta de tenant).
CONTROL_APP_PASSWORD=changeme_control_app_password
# Secreto compartido entre "backend" y "control": protege el endpoint
# interno que usa "control" para avisarle a "backend" que invalide su
# caché de tenant justo después de suspender/reactivar/dar de baja uno
# (ver backend/server.js, POST /internal/cache-tenant/invalidar). Sin
# esto definido en AMBOS contenedores con el MISMO valor, ese aviso falla
# silenciosamente (fire-and-forget) y el cambio tarda hasta 45s en verse
# reflejado, en vez de ser inmediato.
INTERNAL_CACHE_SECRET=changeme_internal_cache_secret
# A dónde debe apuntar nginx para /api/control/* — por defecto el
# contenedor "control" de este mismo docker-compose.yml, en la misma red
# Docker. Si despliegas ese contenedor en OTRO SERVIDOR, cambia estas dos
# por su host/IP/dominio real y puerto público (ver README, sección "App
# de control").
# CONTROL_UPSTREAM_HOST=control
# CONTROL_UPSTREAM_PORT=4001
# Infraestructura MySQL que recibirá las bases físicas de los tenants
# capturados por el intake de /control (segmento 9c, ver PROJECT_STATE.md):
# el contenedor "control" guarda estos dos valores en la solicitud de alta
# y provisionar-tenant.js los respeta al crear la base. Por defecto es la
# misma instancia MySQL compartida (host "mysql" dentro de Docker, usuario
# de aplicación "app") — solo cámbialos si los tenants viven en OTRA
# instancia de MySQL.
# TENANT_DB_HOST=mysql
# TENANT_DB_USER=app

# --- Multi-tenant (arquitectura en migración, ver PROJECT_STATE.md punto 89) ---
# Estas variables ya existen en el código (backend/db.js) pero TODAVÍA no
# tienen ningún efecto observable: nada en la app resuelve tenants por URL
# todavía (eso llega en un segmento posterior del plan). Se documentan aquí
# para no dejarlas "escondidas" — todas tienen un valor por defecto
# razonable si se dejan sin definir.
#
# Límites del registro de pools de conexión por tenant:
# TENANT_POOL_TTL_MS=2700000
# TENANT_POOL_MAX=200
# TENANT_POOL_CONNECTION_LIMIT=5
#
# TTL de la caché en memoria que evita consultar la BD de control en cada
# request para resolver un tenant (ver backend/utils/tenantContext.js):
# TENANT_CACHE_TTL_MS=45000
#
# Conexión a la base de datos de control (catálogo de tenants) — si se
# dejan sin definir, usa el mismo host/usuario/contraseña que DB_* de
# arriba, solo con el nombre de base de datos "control_tenants".
# CONTROL_DB_HOST=
# CONTROL_DB_PORT=
# CONTROL_DB_USER=
# CONTROL_DB_PASSWORD=
# CONTROL_DB_NAME=control_tenants

# --- Almacenamiento de archivos (MinIO, segmento 5 del plan multi-tenant) ---
# IMPORTANTE: cambia esta contraseña antes de desplegar en producción.
# Constancias, imágenes de ticket y facturas ya NO se guardan en disco
# local — viven en MinIO (self-hosted, compatible con S3). Ver
# backend/utils/storage.js y PROJECT_STATE.md.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
# Nombre del bucket compartido (un solo bucket para todos los tenants,
# separados por prefijo dentro de él — no requiere crearse a mano, el
# backend lo crea solo si no existe al arrancar).
MINIO_BUCKET=portal-facturacion
# Puerto de la CONSOLA de administración de MinIO expuesto en el host
# (útil para inspeccionar el bucket con un navegador, mismo espíritu que
# MYSQL_PORT arriba). La API S3 (puerto 9000) nunca se expone al host —
# solo el backend la alcanza, por la red interna de Docker.
MINIO_CONSOLE_PORT=9001

# Tamano maximo permitido por archivo, en megabytes
MAX_FILE_SIZE_MB=5

# Origen permitido para CORS en el backend.
# En produccion, reemplaza "*" por el dominio real, ej: https://facturacion.midominio.com
CORS_ORIGIN=*

# Usuarios administradores que pueden ver los registros y archivos subidos,
# en formato "usuario:contrasena" separados por comas.
# Ejemplo con dos administradores:
# ADMIN_USERS=admin:CambiaEstaClave123,maria:OtraClaveSegura456
ADMIN_USERS=admin:admin

# NOTA: además de lo anterior, el panel también acepta la cuenta de
# respaldo "admin" (guardada en MySQL, no aquí — se siembra sola con la
# contraseña "admin" y se cambia desde la interfaz gráfica), y cualquier
# usuario con perfil "administrador"/"fiscal" creado desde el botón
# "Crear usuario" del panel. Ver la sección "Administración de cuentas y
# contraseñas" del README para el detalle completo de los tres mecanismos.

# Clave secreta para firmar las sesiones de los usuarios del portal (login
# por RFC + contraseña, distinto de ADMIN_USERS). Si se deja vacío, se
# genera una clave aleatoria al arrancar — funciona, pero invalida las
# sesiones activas cada vez que el contenedor se reinicia. Para producción,
# define un valor propio y secreto (ej. `openssl rand -hex 32`).
# SESSION_SECRET=

# Pon esto en "true" SOLO si el sitio se sirve de verdad por HTTPS (ej. ya
# configuraste Nginx + Let's Encrypt en producción, ver README). Si lo
# activas sin HTTPS de por medio, el login deja de funcionar por completo
# (el navegador rechaza guardar la cookie de sesión). En local/LAN/celular
# sin HTTPS, déjalo en "false" (valor por defecto).
COOKIE_SECURE=false

# URL de donde se sincroniza el catalogo de "Uso de CFDI" al presionar
# "Actualizar catálogo SAT" en el panel de administración. Debe responder
# JSON (array de objetos con clave/descripcion) o CSV con encabezado
# (columnas: clave,descripcion). NO hay una URL por defecto: si se deja
# vacío, el botón muestra un mensaje explicándolo en vez de intentar una
# URL sin verificar. El catálogo incluido (23 usos de CFDI vigentes)
# funciona igual mientras tanto, sin necesidad de configurar esto.
# USO_CFDI_SYNC_URL=https://tu-fuente-verificada.example.com/c_UsoCFDI.csv
