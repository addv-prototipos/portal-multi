# Entorno — REGLA GLOBAL (2026-10-19): .env y .env.example (y cualquier
# variante .env.*) NUNCA se versionan. .env.example dejó de estar en el
# repositorio aunque siga siendo la plantilla local que se copia a .env.
.env
.env.*

# Hallazgo M-11 (sonar.html, 2026-10-15): archivo dedicado SOLO a
# ADMIN_USERS que control/ monta :rw — separado del .env principal a
# propósito (blast radius: un control/ comprometido ya no puede leer ni
# reescribir MySQL/SESSION_SECRET/INTERNAL_CACHE_SECRET/etc., solo esta
# línea). admin-users.env.example sí se versiona (sin secretos reales).
admin-users.env
!admin-users.env.example

# Certificados/llaves privadas — nunca al repositorio si alguna vez se
# generan localmente para pruebas de HTTPS.
*.pem
*.key
*.crt
*.p12
*.pfx

# Notas locales de prueba con credenciales — nunca al repositorio
test.md

# Node
node_modules/
npm-debug.log*

# Datos persistentes locales (se generan al ejecutar la app).
# La base de datos ya no vive aqui (ahora es MySQL, en un volumen Docker
# gestionado); solo los archivos subidos siguen siendo una carpeta local.
uploads/*
!uploads/.gitkeep

# Volcados de base de datos que puedas generar con mysqldump localmente
*.sql
!backend/scripts/**/*.sql
!docker/mysql-control-init/**/*.sql

# Sistema
.DS_Store
Thumbs.db

# Papelera local de limpieza de área de trabajo — nunca al repositorio
.trash/

# Paquete de despliegue al VPS de Hostinger (antes "prod/", renombrado
# 2026-10-28 — ahí vive el server de pruebas real) — herramienta de
# despliegue, no código del producto (ver CLAUDE.md): se reescribe con
# cada actualización y se sincroniza por contenido, nunca por git add.
# Formaliza en .gitignore la regla que ya era manual, para que un
# "git add -A" accidental nunca lo arrastre.
hostinger/

# Editores / herramientas locales
.idea/
.claude/

# Pruebas
backend/coverage/
control/coverage/
e2e/test-results/
e2e/playwright-report/
e2e/.cache/
e2e/.slug-e2e.txt

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/
.agents/
.mcp.json
.swarm/

# vercel-labs `skills` CLI (agent-skills, instalado 2026-08-31) — manifiesto
# local de qué skills/versión están symlinkeadas en .agents/skills, mismo
# criterio que .agents/ arriba: herramienta del entorno, no código del sitio.
skills-lock.json
